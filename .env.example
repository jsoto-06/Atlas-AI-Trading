# ACTIVE_EXCHANGE: Exchange activo para operaciones de futuros ('bitget' | 'kraken' | 'hyperliquid')
ACTIVE_EXCHANGE="kraken"

# GEMINI_API_KEY: Requerido para llamadas de análisis cognitivo (Noticias, Sentimiento, Onchain)
GEMINI_API_KEY=""

# APP_URL: URL base donde se aloja la aplicación
APP_URL="http://atlas.lan"

# BITGET EXCHANGE CREDENTIALS
BITGET_API_KEY=""
BITGET_API_SECRET=""
BITGET_PASSPHRASE=""
BITGET_MODO_REAL="false" # "true" para futuros reales, "false" para sandbox demo

# KRAKEN FUTURES (DERIVATIVES) CREDENTIALS
# Web Demo: https://demo-futures.kraken.com
# Web Real: https://futures.kraken.com
KRAKEN_API_KEY=""
KRAKEN_API_SECRET="" # Clave privada decodificable en Base64
KRAKEN_MODO_REAL="false" # "true" para producción en futures.kraken.com, "false" para demo-futures.kraken.com

# HYPERLIQUID DEX (L1 PERPETUALS) CREDENTIALS
# Web Testnet (Faucet gratuito): https://app.hyperliquid-testnet.xyz
# Web Mainnet: https://app.hyperliquid.xyz
HYPERLIQUID_PRIVATE_KEY="" # Clave privada EVM (0x...) de MetaMask o Agent Wallet
HYPERLIQUID_MODO_REAL="false" # "true" para producción en api.hyperliquid.xyz, "false" para testnet con faucet

# CORS ALLOWED ORIGINS
CORS_ALLOWED_ORIGINS="*"

# ADMIN API TOKEN: Token Bearer seguro para proteger endpoints de telemetría y ejecución
ADMIN_API_TOKEN="CHANGE_THIS_SECURE_RANDOM_TOKEN_IN_PRODUCTION"
